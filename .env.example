# Copy to ~/.slopecycle.env and edit. No secrets live here: Google sign-in is stored inside n8n.
SLOPE_MODEL=qwen3:8b
SLOPE_OLLAMA_URL=http://127.0.0.1:11434
# Optional: one hypothesis per line, written by the team. Leave unset if you have none.
# SLOPE_HYPOTHESES_FILE=/Users/you/slopecycle-hypotheses.txt
# Optional: load a Parakeet Ultra model from a folder instead of downloading it.
# SLOPE_ASR_DIR=/path/to/parakeet-ultra
# The n8n "Run now" webhook (shown on the Webhook node after you activate the workflow).
SLOPE_RUN_NOW_URL=http://127.0.0.1:5678/webhook/slopecycle-run-now
