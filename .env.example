# Copied to ~/.slopecycle.env by the installer (only you can read it). Fill in the two SLOPE_QUEUE lines.
# The private queue repo, as owner/name:
SLOPE_QUEUE_REPO=
# The PROCESSOR key (docs/SETUP.md Part 4): Contents read and write on the queue repo only.
SLOPE_QUEUE_TOKEN=
SLOPE_MODEL=qwen3:8b
SLOPE_OLLAMA_URL=http://127.0.0.1:11434
SLOPE_RUN_NOW_URL=http://127.0.0.1:5678/webhook/slopecycle-run
# Optional: one hypothesis per line, written by the team. Leave unset if you have none.
# SLOPE_HYPOTHESES_FILE=/Users/you/slopecycle-hypotheses.txt
